PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :alice :grandparentOf :carol .
  :bob :hasParent :alice .
  :carol :hasParent :bob .

  _:step1
    rdf:reifies <<(:alice :grandparentOf :carol)>>;
    pe:rule "rule#1";
    pe:binding
      [ pe:var "x"; pe:value :alice ],
      [ pe:var "z"; pe:value :carol ].

  _:step2
    rdf:reifies <<(:bob :hasParent :alice)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "child"; pe:value :bob ],
      [ pe:var "parent"; pe:value :alice ].

  _:step3
    rdf:reifies <<(:carol :hasParent :bob)>>;
    pe:rule "rule#2";
    pe:binding
      [ pe:var "child"; pe:value :carol ],
      [ pe:var "parent"; pe:value :bob ].
}
