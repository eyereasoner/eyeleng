    pe:rule "rule#3";
    pe:binding
      [ pe:var "X"; pe:value _:sk_bb32b39908778273d11a8e49e72b9547 ],
      [ pe:var "Y"; pe:value _:sk_319b8a2f709c2e2189803dc77b3d3e85 ];
