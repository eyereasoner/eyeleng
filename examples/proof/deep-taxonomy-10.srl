  :ind a :J8 .
  :ind a :N9 .
  :ind a :I9 .
  :ind a :J9 .
  :ind a :N10 .
  :ind a :I10 .
  :ind a :J10 .
  :ind a :A2 .

  _:step1
    rdf:reifies <<(:ind a :N1)>>;
    pe:rule 1;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses <<(:ind a :N0)>>.

  _:step2
    rdf:reifies <<(:ind a :I1)>>;
    pe:rule 1;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses <<(:ind a :N0)>>.

  _:step3
    rdf:reifies <<(:ind a :J1)>>;
    pe:rule 1;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses <<(:ind a :N0)>>.

  _:step4
    rdf:reifies <<(:ind a :N2)>>;
    pe:rule 2;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step1.

  _:step5
    rdf:reifies <<(:ind a :I2)>>;
    pe:rule 2;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step1.

  _:step6
    rdf:reifies <<(:ind a :J2)>>;
    pe:rule 2;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step1.

  _:step7
    rdf:reifies <<(:ind a :N3)>>;
    pe:rule 3;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step4.

  _:step8
    rdf:reifies <<(:ind a :I3)>>;
    pe:rule 3;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step4.

  _:step9
    rdf:reifies <<(:ind a :J3)>>;
    pe:rule 3;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step4.

  _:step10
    rdf:reifies <<(:ind a :N4)>>;
    pe:rule 4;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step7.

  _:step11
    rdf:reifies <<(:ind a :I4)>>;
    pe:rule 4;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step7.

  _:step12
    rdf:reifies <<(:ind a :J4)>>;
    pe:rule 4;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step7.

  _:step13
    rdf:reifies <<(:ind a :N5)>>;
    pe:rule 5;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step10.

  _:step14
    rdf:reifies <<(:ind a :I5)>>;
    pe:rule 5;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step10.

  _:step15
    rdf:reifies <<(:ind a :J5)>>;
    pe:rule 5;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step10.

  _:step16
    rdf:reifies <<(:ind a :N6)>>;
    pe:rule 6;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step13.

  _:step17
    rdf:reifies <<(:ind a :I6)>>;
    pe:rule 6;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step13.

  _:step18
    rdf:reifies <<(:ind a :J6)>>;
    pe:rule 6;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step13.

  _:step19
    rdf:reifies <<(:ind a :N7)>>;
    pe:rule 7;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step16.

  _:step20
    rdf:reifies <<(:ind a :I7)>>;
    pe:rule 7;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step16.

  _:step21
    rdf:reifies <<(:ind a :J7)>>;
    pe:rule 7;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step16.

  _:step22
    rdf:reifies <<(:ind a :N8)>>;
    pe:rule 8;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step19.

  _:step23
    rdf:reifies <<(:ind a :I8)>>;
    pe:rule 8;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step19.

  _:step24
    rdf:reifies <<(:ind a :J8)>>;
    pe:rule 8;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step19.

  _:step25
    rdf:reifies <<(:ind a :N9)>>;
    pe:rule 9;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step22.

  _:step26
    rdf:reifies <<(:ind a :I9)>>;
    pe:rule 9;
    pe:binding [ pe:var "X"; pe:value :ind ];
    pe:uses _:step22.

  _:step27
    rdf:reifies <<(:ind a :J9)>>;
    pe:rule 9;
    pe:binding [ pe:var "X"; pe:value :ind ];
