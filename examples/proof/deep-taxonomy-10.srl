PREFIX : <http://example/>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

DATA {
  :ind a :N1 .
  :ind a :I1 .
  :ind a :J1 .
  :ind a :N2 .
  :ind a :I2 .
  :ind a :J2 .
  :ind a :N3 .
  :ind a :I3 .
  :ind a :J3 .
  :ind a :N4 .
  :ind a :I4 .
  :ind a :J4 .
  :ind a :N5 .
  :ind a :I5 .
  :ind a :J5 .
