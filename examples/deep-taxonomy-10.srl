# Deep Taxonomy - depth 10
# One individual starts in class N0. Each rule adds the next taxonomy
# class and two side labels. Reaching the final level derives A2.
# The output contains the initial classification and all derived classes.

PREFIX : <http://example/>

DATA {
  :ind a :N0 .
}

RULE {
  ?X a :N1 .
  ?X a :I1 .
  ?X a :J1 .
}
WHERE {
  ?X a :N0 .
}

RULE {
  ?X a :N2 .
  ?X a :I2 .
  ?X a :J2 .
}
WHERE {
  ?X a :N1 .
}

RULE {
  ?X a :N3 .
  ?X a :I3 .
  ?X a :J3 .
}
WHERE {
  ?X a :N2 .
}

RULE {
  ?X a :N4 .
  ?X a :I4 .
  ?X a :J4 .
}
WHERE {
  ?X a :N3 .
}

RULE {
  ?X a :N5 .
  ?X a :I5 .
  ?X a :J5 .
}
WHERE {
  ?X a :N4 .
}

RULE {
  ?X a :N6 .
  ?X a :I6 .
  ?X a :J6 .
}
WHERE {
  ?X a :N5 .
}

RULE {
  ?X a :N7 .
  ?X a :I7 .
  ?X a :J7 .
}
WHERE {
  ?X a :N6 .
}

RULE {
  ?X a :N8 .
  ?X a :I8 .
  ?X a :J8 .
}
WHERE {
  ?X a :N7 .
}

RULE {
  ?X a :N9 .
  ?X a :I9 .
  ?X a :J9 .
}
WHERE {
  ?X a :N8 .
}

RULE {
  ?X a :N10 .
  ?X a :I10 .
  ?X a :J10 .
}
WHERE {
  ?X a :N9 .
}

RULE { ?X a :A2 . }
WHERE {
  ?X a :N10 .
}
